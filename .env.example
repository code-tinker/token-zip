# ============================================
# Token-Zip Configuration
# ============================================

# Server
PORT=3000

# ---- Compression Model (cheap & fast) ----
# API type: "openai" (OpenAI-compatible) or "anthropic"
COMPRESS_API_TYPE=openai
COMPRESS_MODEL=kimi-k2.5
COMPRESS_API_KEY=your-compression-model-api-key
COMPRESS_BASE_URL=https://api.moonshot.cn/v1

# ---- Target Model (expensive & powerful) ----
# API type: "openai" (OpenAI-compatible) or "anthropic"
TARGET_API_TYPE=anthropic
TARGET_MODEL=claude-opus-4.6
TARGET_API_KEY=your-target-model-api-key
TARGET_BASE_URL=https://api.anthropic.com

# ---- Optional ----
# Override USD/CNY exchange rate (default: 7.25)
# USD_CNY_RATE=7.25

# Log level: "debug" | "info" | "warn" | "error"
# LOG_LEVEL=info
